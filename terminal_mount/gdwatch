#!/usr/bin/env python3
"""Run the source checkout or the installed Google Docs reader."""
from pathlib import Path
import os
import sys

here = Path(__file__).resolve().parent
server = here / 'drive_reader' / 'server.py'
if not server.is_file():
    server = here.parent / 'lib' / 'gdwatch' / 'server.py'
if not server.is_file():
    raise SystemExit('gdwatch: reader files are missing. Run terminal_mount/install.sh.')
# Replace this process so server.py still sees the calling shell as its parent.
os.execv(sys.executable, [sys.executable, str(server), *sys.argv[1:]])
